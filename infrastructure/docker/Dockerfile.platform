FROM maven:3.9.11-eclipse-temurin-21 AS build
WORKDIR /build
COPY services/platform/pom.xml .
RUN mvn -B -q dependency:go-offline
COPY services/platform/src ./src
RUN mvn -B -q package

FROM eclipse-temurin:21-jre
RUN apt-get update && apt-get install -y --no-install-recommends curl \
 && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 10001 --create-home concierge
WORKDIR /app
COPY --from=build /build/target/core-service-0.1.0.jar /app/core-service.jar
USER concierge
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "/app/core-service.jar"]
