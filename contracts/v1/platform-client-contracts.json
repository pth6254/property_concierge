  "valuation_assessment_schema": {
    "$defs": {
      "JeonseContext": {
        "additionalProperties": false,
        "description": "동일 단지 전세·매매 ㎡당 중앙값의 대조. 가격 추정이 아니며 표본이 적으면 sufficient=false다.",
        "properties": {
          "area_tolerance_pct": {
            "title": "Area Tolerance Pct",
            "type": "integer"
          },
          "complex_name": {
            "title": "Complex Name",
            "type": "string"
          },
          "lease_count": {
            "title": "Lease Count",
            "type": "integer"
          },
          "lease_per_sqm_median_won": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Lease Per Sqm Median Won"
          },
          "leases": {
            "items": {
              "$ref": "#/$defs/JeonseLease"
            },
            "title": "Leases",
            "type": "array"
          },
          "missing_months": {
            "default": 0,
            "title": "Missing Months",
            "type": "integer"
          },
          "ratio_pct": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Ratio Pct"
          },
          "renewal_count": {
            "default": 0,
            "title": "Renewal Count",
            "type": "integer"
          },
          "sale_count": {
            "title": "Sale Count",
            "type": "integer"
          },
          "sale_per_sqm_median_won": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Sale Per Sqm Median Won"
          },
          "sufficient": {
            "default": false,
            "title": "Sufficient",
            "type": "boolean"
          },
          "window_months": {
            "title": "Window Months",
            "type": "integer"
          }
        },
        "required": [
          "window_months",
          "area_tolerance_pct",
          "complex_name",
          "lease_count",
          "sale_count"
