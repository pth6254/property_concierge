    {
      "input_schema": {
        "additionalProperties": false,
        "properties": {
          "as_of_date": {
            "format": "date",
            "title": "As Of Date",
            "type": "string"
          },
          "asking_price_won": {
            "anyOf": [
              {
                "exclusiveMinimum": 0,
                "maximum": 1000000000000000,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Asking Price Won"
          },
          "cap_rate_max_pct": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.1,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,4}0*$",
                "type": "string"
              }
            ],
            "title": "Cap Rate Max Pct"
          },
          "cap_rate_min_pct": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.1,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,4}0*$",
                "type": "string"
              }
            ],
            "title": "Cap Rate Min Pct"
          },
          "monthly_operating_cost_max_won": {
            "anyOf": [
              {
                "maximum": 1000000000000000,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Monthly Operating Cost Max Won"
          },
          "monthly_operating_cost_min_won": {
            "anyOf": [
              {
                "maximum": 1000000000000000,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Monthly Operating Cost Min Won"
          },
          "monthly_rent_won": {
            "maximum": 1000000000000000,
            "minimum": 0,
            "title": "Monthly Rent Won",
            "type": "integer"
          },
          "valuation_unit": {
            "enum": [
              "single_unit",
              "whole_building"
            ],
            "title": "Valuation Unit",
            "type": "string"
          }
        },
        "required": [
          "monthly_rent_won",
          "cap_rate_min_pct",
          "cap_rate_max_pct",
          "valuation_unit",
          "as_of_date"
        ],
        "title": "IncomeValuationInput",
        "type": "object"
      },
      "method": "POST",
      "path": "/internal/v1/calculations/income_valuation",
      "result_kinds": [
        "conditional_scenario",
        "withheld"
      ],
      "source": "services/intelligence/backend/services/valuation_support.py",
      "version": "income-scenario-1.0"
    },
