# ─────────────────────────────────────────────────────────────
#  Property Concierge — 환경변수 템플릿
#
#  cp .env.example .env  후 값을 채운다. .env 는 절대 커밋하지 않는다.
#  ✅ = 없으면 핵심 기능이 동작하지 않음 / ○ = 선택(없으면 폴백 동작)
# ─────────────────────────────────────────────────────────────

# ── 필수 외부 API ────────────────────────────────────────────
# ✅ 카카오 지오코딩·주소검색 (REST API 키. JavaScript 키 아님)
#    403 발생 시 개발자 콘솔 → 플랫폼 → Web 에 http://localhost 등록
KAKAO_REST_API_KEY=
# ✅ 국토교통부 실거래가 (공공데이터포털 일반 인증키 Decoding)
MOLIT_API_KEY=
# 행정안전부 법정동코드 동기화 전용 키. 비우면 MOLIT_API_KEY를 재사용한다.
MOIS_REGION_API_KEY=

# ── 선택 외부 API ────────────────────────────────────────────
# ○ 한국부동산원 R-ONE 월간지수 — 시점수정 정밀화 (없으면 근사 변동률 폴백)
RBONE_API_KEY=
# ○ 한국은행 ECOS — 시뮬레이션 금리 자동 세팅 (없으면 4.0% 폴백)
ECOS_API_KEY=
# ○ 국가법령정보센터 — 챗봇 법령·판례 코퍼스 확장 (없으면 시드 코퍼스만 사용)
LAW_OC_KEY=
# ○ Vworld — 토지 용도지역 조회
VWORLD_API_KEY=
# ○ Tavily — 웹 시세 검색 보조
TAVILY_API_KEY=

# ── 인증 / 세션 ──────────────────────────────────────────────
# ✅ 운영(APP_ENV=production)에서는 필수 — 미설정 시 기동 실패
#    생성 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
# development | production  (production 이면 쿠키 secure 플래그 활성화)
APP_ENV=development

# 세션 쿠키의 SameSite: lax | none | strict
#   lax  (기본) — 프론트와 API 가 브라우저에게 **같은 출처**로 보이는 배포에서 사용.
#                 현재 구조가 그렇다 (next.config.ts 의 rewrites 가 /api/* 를 중계).
#   none        — 프론트와 API 를 서로 다른 사이트에 배포한 경우에만
#                 (예: app.vercel.app ↔ api.fly.dev). 이 값이면 HTTPS 가 필수이며
#                 APP_ENV 와 무관하게 secure 플래그가 자동으로 켜진다.
#   strict      — 외부 링크로 진입하면 로그아웃 상태로 보인다(메일 링크 등에 불리).
COOKIE_SAMESITE=lax

# ── Google OAuth (미설정 시 소셜 로그인 버튼만 비활성)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000
# 다른 서비스가 8000을 사용한다면 호스트의 API 포트만 변경한다. 컨테이너 내부는 8000.
API_BIND_PORT=8000

# ── 서버 ─────────────────────────────────────────────────────
# CORS 허용 오리진 (콤마 구분). 배포 시 실제 도메인으로 교체할 것.
CORS_ORIGINS=http://localhost:3000,http://frontend:3000
# 1 로 두면 레이트 리밋 비활성 (개발·테스트 전용, 운영에서 절대 금지)
DISABLE_RATE_LIMIT=

# 리버스 프록시(nginx·LB·Cloudflare) 뒤에 배포할 때 **반드시** 설정할 것.
#
# 왜 필요한가: 프록시를 거치면 FastAPI 에는 모든 요청이 프록시 IP 하나로 들어온다.
# 레이트 리밋과 로그인 잠금이 IP 기준이라, 이 상태면 전체 사용자가 한 덩어리로
# 묶여 한도를 공유하게 된다(= 몇 명만 써도 나머지가 429, IP 차단은 무의미).
# 실제 사용자 IP 는 프록시가 붙이는 X-Forwarded-For 헤더에 들어 있다.
#
# uvicorn 은 이 환경변수를 자동으로 읽는다(코드 변경 불필요). 기본값은
# "127.0.0.1" 이라 **같은 기계**의 프록시만 신뢰한다 — docker compose 처럼
# 프록시가 별도 컨테이너면 기본값으로는 동작하지 않으므로 그 IP/대역을 지정한다.
#
# ⚠️ "*" 로 열어두고 앱이 외부에 직접 노출되면, 공격자가 X-Forwarded-For 를
#    위조해 레이트 리밋을 무한 우회할 수 있다. 프록시 주소를 정확히 적을 것.
# 예: FORWARDED_ALLOW_IPS=172.18.0.0/16   또는   FORWARDED_ALLOW_IPS=10.0.0.5
FORWARDED_ALLOW_IPS=

# ── LLM 프로바이더 ───────────────────────────────────────────
# ollama | openrouter | openai | anthropic | google
LLM_PROVIDER=ollama
# 챗봇·종합 컨시어지만 OpenRouter로 전환하려면 openrouter. 비우면 LLM_PROVIDER 사용.
CHAT_LLM_PROVIDER=
# 시세추정 의도분석(주소·유형 검색 힌트)만 전환하려면 openrouter. 지오코딩 좌표는 주소 API가 검증.
APPRAISAL_INTENT_LLM_PROVIDER=
EMBED_PROVIDER=ollama

# ollama (기본) — 사전에 `ollama pull` 필요
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_HOST=http://localhost:11434

# OpenRouter 챗봇 전환: CHAT_LLM_PROVIDER=openrouter, 아래 두 값 필수.
# 무료 라우터 또는 :free 접미 모델만 허용한다. 키는 저장소에 커밋하지 않는다.
# 기존 pgvector 문서와 같은 임베딩 모델을 유지하려면 EMBED_PROVIDER=ollama 그대로 둔다.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=Property Concierge

# openai / anthropic / google 로 전환 시에만 필요
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=

# ── 데이터베이스 ──────────────────────────────────────────────
# ✅ PostgreSQL 컨테이너 자격증명 — docker-compose.yml 이 이 값을 읽어 pgvector 를 초기화한다.
#    저장소에 실제 비밀번호를 커밋하지 말 것. 생성 예: openssl rand -base64 32
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=real_estate_db

# ✅ 앱 테이블(사용자·이력·활동·캐시·실거래가·상담 코퍼스) — PostgreSQL 필수.
#    로컬 개발도 SQLite 폴백 없이 Postgres가 필요하다: `docker compose up pgvector redis`
#    docker compose 로 api 를 띄우면 위 POSTGRES_* 값을 조합해 자동 주입되므로 비워둬도 된다.
#    컨테이너 밖에서 스크립트·테스트를 직접 돌릴 때만 아래 값을 채운다 (POSTGRES_PASSWORD와 동일하게).
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/real_estate_db
# ✅ RAG 벡터스토어(pgvector) — DATABASE_URL과 같은 인스턴스를 가리킨다 (다른 라이브러리 경로라 변수만 분리)
PG_CONNECTION_STRING=postgresql://postgres:${POSTGRES_PASSWORD}@localhost:5432/real_estate_db
# ✅ 작업 큐 상태·레이트 리밋·로그인 잠금 카운터 — Redis 필수 (멀티 워커 배포 시 상태 공유)
REDIS_URL=redis://localhost:6379/0

# ── 메일 발송 (비밀번호 재설정) ────────────────────────────────
# ○ Resend API 키. 비워두면 실제 발송 대신 **서버 로그에 재설정 링크를 출력**한다
#    (로컬 개발·CI 가 외부 메일 서비스에 의존하지 않도록 한 의도적 폴백).
#    초대 베타 단계에서는 운영자가 로그의 링크를 수동 전달해 계정을 복구해줄 수 있다.
RESEND_API_KEY=
# 발신자 주소 — 실발송하려면 Resend 에서 도메인 인증(SPF/DKIM)이 끝난 주소여야 한다.
MAIL_FROM=no-reply@localhost
# 재설정 링크의 도메인. FRONTEND_URL 을 그대로 쓴다(위 Google OAuth 섹션 참고).

# ── 관측성 ────────────────────────────────────────────────────
# ○ Sentry 에러 추적 — 비워두면 완전히 비활성 (로컬 개발·CI에 영향 없음).
#    운영에서 값을 채우는 순간부터만 켜진다. sentry.io 프로젝트 생성 후 DSN 발급.
SENTRY_DSN=
# 트랜잭션(성능) 샘플링 비율 0.0~1.0 — 기본 10%. 에러는 샘플링과 무관하게 항상 전송된다.
SENTRY_TRACES_SAMPLE_RATE=0.1

# 기존 관리자 계정 ID를 쉼표로 지정한다. 미설정이면 운영 API 접근을 허용하지 않는다.
OPERATOR_USER_IDS=
